{application, mcl_tube, [
    {description, "Video channels over the mesh: owners publish clips, anyone looks them up and streams them"},
    {vsn, "0.1.0"},
    {registered, [mcl_tube_sup]},
    {mod, {mcl_tube_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        cowboy,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om,
        %% The departments, started before this app so mcl_om:boot/1 finds
        %% them up when it opens the store.
        guide_tube_lifecycle,
        project_tube,
        query_tube
    ]},
    {env, [
        %% The owner UI and read API listener. Loopback by default: the UI has
        %% no authentication of its own (see mcl_tube_sup).
        {http_port, 8491},
        {http_ip, "127.0.0.1"}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-tube"}]}
]}.
