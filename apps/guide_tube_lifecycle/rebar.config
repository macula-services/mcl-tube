{erl_opts, [debug_info, warnings_as_errors]}.
%% "test" must be listed explicitly alongside the desk dirs -- an explicit
%% src_dirs list replaces rebar3's default ["src", "test"], it doesn't
%% extend it, so omitting "test" here silently drops this app's eunit
%% suite from every `rebar3 eunit' run.
{src_dirs, ["src", "src/initiate_channel", "src/reconfigure_channel",
           "src/upload_video_clip", "src/publish_video_clip",
           "src/retract_video_clip", "src/archive_video_clip",
           "src/record_video_clip_view", "src/channel_announced_v1_to_mesh",
           "src/video_clip_announced_v1_to_mesh",
           "src/video_clip_viewed_v1_to_mesh", "test"]}.
{shell, [{apps, [guide_tube_lifecycle]}]}.
