%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_tube.
%%
%% Video channels over the mesh: owners publish clips, anyone looks them up and streams them
%%
%% An umbrella of four apps: guide_tube_lifecycle (CMD, the channel and clip
%% lifecycles, event sourced), project_tube (PRJ, the in-memory read model),
%% query_tube (QRY, the mesh lookups and the watch stream) and mcl_tube (the
%% service, and the owner's web UI).

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% mcl_tube_service exports store_id/0 + data_dir/0, so mcl_om:boot/1
    %% opens the store and its evoq subscription before start/1 runs.
    %% 0.26.2 floor: it refuses to start on an identity key it cannot save.
    {mcl_om, "~> 0.26.2"},
    %% Declared directly because the desks call macula's publisher, streamer,
    %% download and response behaviours themselves.
    {macula, "~> 12.0"},
    %% The owner web UI's HTTP listener.
    {cowboy, "~> 2.12"},
    %% 1.24 marks a restart's replayed events, so the publishing handlers can
    %% declare replay_policy() -> skip instead of re-publishing history on
    %% every boot. mcl_om alone would accept any 1.21+.
    {evoq, "~> 1.24"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

{relx, [
    {release, {mcl_tube, "0.1.0"}, [guide_tube_lifecycle, project_tube, query_tube,
                                    mcl_tube, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    %% meck stands in for the store and the mesh where a test needs to see
    %% exactly what a desk hands on.
    {test, [{deps, [{meck, "~> 1.2"}]}]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
