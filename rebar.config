%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_tube.
%%
%% Video channels over the mesh: owners publish clips, anyone looks them up and streams them
%%
%% An umbrella of four apps: guide_tube_lifecycle (CMD, the channel and clip
%% lifecycles, event sourced), project_tube (PRJ, the in-memory read model),
%% query_tube (QRY, the mesh lookups and the watch stream) and mcl_tube (the
%% service, and the owner's web UI).

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% It opens no store from 0.35 on (mcl-om#10): mcl_tube_app opens this
    %% service's own (mcl_tube_store) before mcl_om:boot/1. 0.38 builds on
    %% macula 14. Our libraries float at ~> MAJOR.MINOR, released versions only.
    {mcl_om, "~> 0.39"},
    %% Declared directly because the desks call macula's publisher, streamer
    %% and response behaviours themselves. It seals calls and streams end to
    %% end, which every capability requires (`kem_advertise' in
    %% sys.config.src); 14.1 puts each advertisement a caller seals to in the
    %% DHT (macula#33), and 14.2.1 makes the watch stream's `required' reach
    %% its advertisement (macula#85).
    {macula, "~> 14.2"},
    %% The owner web UI's HTTP listener.
    {cowboy, "~> 2.12"},
    %% THIS SERVICE'S OWN EVENT STORE, opened by mcl_tube_app before
    %% mcl_om:boot/1 (mcl_om 0.35 brings none of these). evoq 1.24 marks a
    %% restart's replayed events, so the publishing handlers can declare
    %% replay_policy() -> skip; 1.26.1 measures telemetry durations on the
    %% monotonic clock. reckon_evoq 2.7.2 reads snapshots back whole.
    {reckon_db,   "~> 5.4"},
    {evoq,        "~> 1.26"},
    {reckon_evoq, "~> 2.7"}
]}.

%% khepri 0.17 (via reckon_db) uses the deprecated `catch' expression, which
%% warnings_as_errors refuses on OTP 28+.
{overrides, [
    {override, khepri, [{erl_opts, [nowarn_deprecated_catch]}]}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% The owner UI calls ranch and cowlib directly (its listener's child spec, the
%% multipart parser) and the lifecycle builds reckon_gater stream ids; none is
%% a direct dependency, so none is in the PLT unless it is named here.
{dialyzer, [{plt_extra_apps, [ranch, cowlib, reckon_gater]}]}.

{relx, [
    {release, {mcl_tube, "0.4.1"}, [guide_tube_lifecycle, project_tube, query_tube,
                                    mcl_tube, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    %% meck stands in for the store and the mesh where a test needs to see
    %% exactly what a desk hands on.
    {test, [{deps, [{meck, "~> 1.2"}]}]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
